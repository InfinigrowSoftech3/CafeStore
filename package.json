{
  "name": "brewhaus-cafe",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CUSTOMER,POS,KDS,ADMIN\" -c \"blue,green,yellow,cyan,magenta\" \"npm run dev:server\" \"npm run dev:customer\" \"npm run dev:pos\" \"npm run dev:kds\" \"npm run dev:admin\"",
    "dev:server": "cd server && npm run dev",
    "dev:customer": "npm run dev --workspace=@cafe/customer",
    "dev:pos": "npm run dev --workspace=@cafe/pos",
    "dev:kds": "npm run dev --workspace=@cafe/kds",
    "dev:admin": "npm run dev --workspace=@cafe/admin",
    "dev:all": "npm run dev",
    "build": "npm run build --workspaces --if-present && node scripts/prepare-dist.cjs",
    "build:customer": "npm run build --workspace=@cafe/customer",
    "build:pos": "npm run build --workspace=@cafe/pos",
    "build:kds": "npm run build --workspace=@cafe/kds",
    "build:admin": "npm run build --workspace=@cafe/admin",
    "lint": "eslint .",
    "build:client": "npm run build:customer",
    "test": "cd server && npm test",
    "seed": "cd server && npm run seed",
    "clean:db": "cd server && npm run clean:db"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
