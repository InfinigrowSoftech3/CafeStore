# ── 1. MANDATORY BASE ENVIRONMENT VARIABLES (Required for ALL deployments) ────
NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string (readWrite user, replica set)
MONGO_URI=mongodb+srv://<production-user>:<password>@<production-cluster>.mongodb.net/brewhaus?retryWrites=true&w=majority

# High-entropy cryptographic secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=<unique-production-secret-at-least-32-characters>
TABLE_QR_SECRET=<unique-production-qr-secret-at-least-32-characters>

# 32 random bytes, base64 encoded for tenant credentials encryption at rest:
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TENANT_CREDENTIALS_ENCRYPTION_KEY=<32-byte-base64-key>

# Primary frontend client URL for CORS allowlisting
CLIENT_URL=https://cafestore-customer.vercel.app

# ── 2. PAYMENT CONFIGURATION (Choose Mode A or Mode B) ─────────────────────────

# Option A: Online Payments ENABLED (Razorpay Live)
# Uncomment these when live payments are active:
# PAYMENT_MODE=live
# PAYMENTS_ENABLED=true
# RAZORPAY_KEY_ID=rzp_live_<your-live-key-id>
# RAZORPAY_KEY_SECRET=<your-live-key-secret>
# RAZORPAY_WEBHOOK_SECRET=<your-webhook-secret-min-32-chars>

# Option B: Online Payments INTENTIONALLY DISABLED (Cash / POS Counter Billing Only)
# Use this on Render if Razorpay is not yet configured, or for counter-only cafés.
# Allows the server to boot smoothly without Razorpay credentials; safely rejects online payment attempts.
PAYMENT_MODE=disabled
PAYMENTS_ENABLED=false

# For staging / testing environments ONLY:
# PAYMENT_MODE=test
# ALLOW_TEST_PAYMENTS=true
# RAZORPAY_KEY_ID=rzp_test_<test-key>
# RAZORPAY_KEY_SECRET=<test-secret>

# ── 3. REDIS & DISTRIBUTED RATE LIMITING (Recommended for Multi-Instance) ──────
# Recommended for production deployments with multiple Render instances/replicas.
# When REDIS_URL is configured, rate limiting and live updates are distributed across pods.
# When REDIS_URL is omitted, in-memory rate limiting and in-memory live updates are used (suitable for single-instance).
# Set REQUIRE_REDIS=true to enforce startup failure if Redis is missing.
# REDIS_URL=rediss://default:<password>@<host>:<port>
# REQUIRE_REDIS=false

# ── 4. PROXY & REVERSE PROXY SETTINGS ──────────────────────────────────────────
# Render terminates TLS and acts as 1 proxy hop. Set to 1 on bare Render.
# If using Cloudflare in front of Render (Orange cloud proxy), set to 2.
TRUST_PROXY_HOPS=1

# ── 5. TENANCY & DOMAINS ───────────────────────────────────────────────────────
TENANT_BASE_DOMAIN=infinigrowsoftech.com
TENANT_DEFAULT_SLUG=brewhaus
CUSTOMER_APP_URL=https://cafestore-customer.vercel.app
POS_APP_URL=https://cafestore-pos.vercel.app
KDS_APP_URL=https://cafestore-kds.vercel.app
ADMIN_APP_URL=https://cafestore-admin.vercel.app
SERVER_URL=https://cafestore-nmue.onrender.com

# ── 6. PLATFORM SUPER ADMIN BOOTSTRAP (Optional) ───────────────────────────────
# Used only to seed the first platform super admin when the database is empty.
# Leave both unset once created or if admins already exist in MongoDB.
# SUPER_ADMIN_EMAIL=admin@yourdomain.com
# SUPER_ADMIN_PASSWORD=<strong-unique-password>

# ── 7. RATE LIMITING TUNING (Optional) ─────────────────────────────────────────
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1500
PUBLIC_RATE_LIMIT_MAX=1500
AUTH_RATE_LIMIT_MAX=20
SENSITIVE_RATE_LIMIT_MAX=60

# ── 8. EMAIL & NOTIFICATIONS (Optional) ────────────────────────────────────────
# Recommended on Render: Resend HTTP API (avoids blocked outbound SMTP ports 25/465/587)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=BrewHaus <noreply@brewhauscafe.com>
# VAPID_PUBLIC_KEY=<vapid-public-key>
# VAPID_PRIVATE_KEY=<vapid-private-key>
# VAPID_SUBJECT=mailto:admin@brewhauscafe.com

# ── 9. DIAGNOSTICS & TELEMETRY (Optional) ──────────────────────────────────────
DEBUG_IP_ENDPOINT=false
# SENTRY_DSN=https://<key>@sentry.io/<project>
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
